# Radiarr Optional Server Overrides (all have built-in defaults)
# PORT=8484
# TZ=UTC
# CONFIG_DIR=./data/config
# MUSIC_DIR=./data/music
# TRANSCODE_BITRATE_KBPS=192
# TRANSCODE_CACHE_MAX_MB=2048
# STREAM_BITRATE_KBPS=192

# Network Share / Remote Folder Credentials (Optional, if using authenticated network shares)
# RADIARR_NAS_HOST=192.168.1.50
# RADIARR_NAS_USER=admin
# RADIARR_NAS_PASSWORD=your_password_here


