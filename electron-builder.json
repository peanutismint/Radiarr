{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.radiarr.app",
  "productName": "Radiarr",
  "copyright": "Copyright © 2026 Radiarr",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-desktop/**/*",
    "server.ts",
    "src/server/**/*",
    "package.json"
  ],
  "extraMetadata": {
    "main": "dist-desktop/main.cjs"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Radiarr"
  },
  "publish": null,
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": ["x64", "arm64"]
      },
      {
        "target": "zip",
        "arch": ["x64", "arm64"]
      }
    ],
    "category": "public.app-category.music",
    "darkModeSupport": true,
    "identity": null
  },
  "linux": {
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64"]
      },
      {
        "target": "deb",
        "arch": ["x64"]
      }
    ],
    "category": "Audio",
    "maintainer": "peanutismint <peanutismint@users.noreply.github.com>",
    "synopsis": "Turn your music library into 24/7 continuous live radio stations",
    "description": "Radiarr is a continuous live broadcast server and desktop player that turns local music collections into automated virtual radio stations."
  }
}
